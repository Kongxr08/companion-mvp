# Copy to .env; restart the Python process after editing. Never share .env.
# auto: use demo when LLM_MODEL is empty; otherwise use a real model.
CHAT_MODE=auto

# OpenAI Responses API. Fill an available text model ID from your provider.
LLM_API_STYLE=responses
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Compatible providers / local model servers:
# LLM_API_STYLE=chat_completions
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=your-loaded-model-id
# LLM_API_KEY=
